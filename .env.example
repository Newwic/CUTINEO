# Public Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only Supabase key. Never expose this in NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Upstash Redis REST API
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Optional second provider. The server-side router can fail over between providers.
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
AI_DEFAULT_PROVIDER=gemini
AI_USD_TO_THB=36

# Comma-separated Supabase auth user IDs allowed to open /admin/ai-usage.
# Keep this server-only; do not use a NEXT_PUBLIC_* variable.
CUTINEO_PLATFORM_ADMIN_USER_IDS=

# Secret used by the protected webhook worker endpoint.
# Generate a random value of at least 16 characters.
WORKER_SECRET=replace-with-a-long-random-secret
# Optional separate secret for a platform cron provider.
CRON_SECRET=replace-with-a-long-random-secret

# Optional: allow the static Vite/GitHub Pages frontend to call the Next.js API.
# Use an origin only, without a path; separate multiple origins with commas.
CHAT_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:1420,https://your-frontend.example.com
VITE_CHAT_API_URL=https://your-api.example.com/api/chat-stream

# Used by the API when generating absolute callback URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
